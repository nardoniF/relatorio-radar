# Porta do servidor HTTP
PORT=3001

# Modo de armazenamento: memory (padrão, sem Docker) | postgres
STORE=memory

# PostgreSQL + PostGIS (Neon/Supabase free ok)
# Ex.: postgresql://radar:radar@localhost:5432/relatorio_radar
DATABASE_URL=

# Provider padrão: local (zero-custo, OSM/PostGIS-style)
# here = complementar opcional — NÃO necessário para o MVP
PROVIDER=local

# Somente se PROVIDER=here (complementar). Nunca no app iOS.
HERE_API_KEY=

# JWT opcional (fase futura)
# JWT_SECRET=
