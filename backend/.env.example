# Porta do servidor HTTP
PORT=3001

# Modo de armazenamento: memory (padrão, sem Docker) | postgres
STORE=memory

# PostgreSQL + PostGIS (obrigatório quando STORE=postgres)
# Ex.: postgresql://radar:radar@localhost:5432/relatorio_radar
DATABASE_URL=

# HERE Platform — apenas no backend (nunca no cliente iOS/web)
# Necessário somente com PROVIDER=here
HERE_API_KEY=

# Provedor de mapa/radares/limites: demo | here
PROVIDER=demo

# JWT opcional (fase futura)
# JWT_SECRET=
